# Template: confirm the service account and paths on the frontend EC2.
[Unit]
Description=Expense Management Frontend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/expense-frontend
Environment=NODE_ENV=production
EnvironmentFile=-/opt/expense-frontend/.env
ExecStart=/usr/bin/node /opt/expense-frontend/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
