# Template: confirm the service account and paths on the backend EC2.
[Unit]
Description=Expense Management Backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/expense-backend
Environment=NODE_ENV=production
EnvironmentFile=-/opt/expense-backend/.env
ExecStart=/usr/bin/node /opt/expense-backend/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
